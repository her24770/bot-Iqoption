# =====================================================================
#  IQBot — Variables de entorno
#  Copia este archivo a ".env" y completa los valores:
#       cp .env.example .env
#  Docker Compose lee el .env de esta carpeta (la raíz del proyecto).
# =====================================================================

# ---------------------------------------------------------------------
#  IQ Option
#  Si dejas estos campos vacíos, el bot arranca en MODO SIMULACIÓN
#  (genera datos sintéticos) y funciona localmente sin cuenta real.
#  En tu servidor, completa con tus credenciales reales de IQ Option.
# ---------------------------------------------------------------------
IQOPTION_EMAIL=
IQOPTION_PASSWORD=

# ---------------------------------------------------------------------
#  OpenAI (GPT-4o mini)
#  Si dejas la API key vacía, el paso de GPT se omite y se aprueba la
#  señal de los patrones (útil para probar en local sin gastar tokens).
# ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
#  Base de datos PostgreSQL
#  IMPORTANTE: DB_PASSWORD y la contraseña dentro de DATABASE_URL
#  DEBEN coincidir. El host "iqbot-db" es el nombre del servicio en Docker.
# ---------------------------------------------------------------------
DB_PASSWORD=iqbot_password_seguro
DATABASE_URL=postgresql://iqbot:iqbot_password_seguro@iqbot-db:5432/iqbot_db

# ---------------------------------------------------------------------
#  Redis (host "iqbot-redis" = nombre del servicio en Docker)
# ---------------------------------------------------------------------
REDIS_URL=redis://iqbot-redis:6379

# ---------------------------------------------------------------------
#  Autenticación del dashboard
#  El usuario admin se crea automáticamente al arrancar con estos datos.
#  JWT_SECRET debe ser una cadena larga y aleatoria.
# ---------------------------------------------------------------------
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRE_HOURS=24
DASHBOARD_EMAIL=admin@tudominio.com
DASHBOARD_PASSWORD=admin123

# ---------------------------------------------------------------------
#  Aplicación (backend)
#  CORS_ORIGINS: orígenes permitidos para llamar a la API (separados por coma).
#  En local debe incluir http://localhost:5173 (el dashboard).
# ---------------------------------------------------------------------
APP_ENV=production
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
#  Dashboard (frontend)
#  VITE_API_URL: URL del backend que el navegador usará. En local es
#  http://localhost:8000. En tu servidor: http://IP_DEL_SERVER:8000
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
